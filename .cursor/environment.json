{
  "name": "gadfly-server",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "MONGO_URI=\"mongodb://127.0.0.1:27017/gadfly_dating\" node server.js"
    }
  ],
  "ports": [
    {
      "name": "backend",
      "port": 5000
    }
  ]
}
